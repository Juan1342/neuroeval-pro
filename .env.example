# Copia este archivo como .env en desarrollo.
# No agregues valores reales ni secretos a GitHub.

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Firebase Web (valores públicos de la aplicación web)
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID

# Firebase Admin: pega aquí el JSON completo como una sola variable secreta.
# Alternativa: configura Application Default Credentials en el entorno.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Correo transaccional mediante Brevo API (recomendado en Render Free)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=soporte.neuroevalpro@gmail.com
BREVO_FROM_NAME=NeuroEval Pro

# Resend queda disponible como alternativa.
RESEND_API_KEY=
RESEND_FROM=

# SMTP queda disponible como alternativa si se usa un hosting que permita esos puertos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Administrador autorizado (correo reservado del proyecto)
ADMIN_EMAIL=jzamorazapata@gmail.com
ADMIN_NAME=Administrador NeuroEval Pro
# Solo completar si se va a crear la cuenta o cambiar expresamente la contraseña.
ADMIN_PASSWORD=

# Wompi: usa credenciales del mismo entorno (sandbox o producción).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Debe permanecer desactivado en producción.
ALLOW_DEMO_PAY=false
